{
  "name": "vscode-janja",
  "displayName": "Janja",
  "description": "Syntax highlighting, diagnostics, completions, hover and formatting for Janja templates",
  "version": "0.1.1",
  "private": true,
  "publisher": "vvenv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvenv/janja.git",
    "directory": "packages/vscode-janja"
  },
  "homepage": "https://janja.wenfu.dev",
  "bugs": "https://github.com/vvenv/janja/issues",
  "keywords": [
    "janja",
    "template",
    "template-engine",
    "jinja",
    "html"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "janja",
        "aliases": [
          "Janja",
          "janja"
        ],
        "extensions": [
          ".janja"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "janja",
        "scopeName": "text.html.janja",
        "path": "./syntaxes/janja.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.janja": "janja"
        }
      },
      {
        "scopeName": "janja.injection",
        "path": "./syntaxes/janja.injection.tmLanguage.json",
        "injectTo": [
          "text.html.janja"
        ]
      }
    ]
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "package": "cp ../../LICENSE . && pnpm dlx @vscode/vsce@3 package --no-dependencies --out janja.vsix",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.90.0",
    "janja-language-server": "workspace:*",
    "rollup": "^4.64.7",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
