{
  "name": "eslint-plugin-janja",
  "version": "1.1.4",
  "description": "ESLint plugin for Janja template formatting",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvenv/janja.git",
    "directory": "packages/eslint-plugin-janja"
  },
  "homepage": "https://janja.wenfu.dev",
  "bugs": "https://github.com/vvenv/janja/issues",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "dev": "vitest watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "janja",
    "template",
    "formatting"
  ],
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@eslint/core": "^1.2.1",
    "@eslint/plugin-kit": "^0.7.3",
    "janja": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/ui": "5.0.4",
    "eslint": "^10.12.0",
    "rollup": "^4.64.5",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
