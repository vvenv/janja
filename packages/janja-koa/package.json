{
  "name": "janja-koa",
  "version": "0.1.0",
  "description": "Janja view rendering for Koa",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvenv/janja.git",
    "directory": "packages/janja-koa"
  },
  "homepage": "https://janja.wenfu.dev",
  "bugs": "https://github.com/vvenv/janja/issues",
  "keywords": [
    "koa",
    "middleware",
    "views",
    "janja",
    "template"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
