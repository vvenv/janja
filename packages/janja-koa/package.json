    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "janja": "workspace:^"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/node": "^24.10.3",
    "janja": "workspace:*",
    "koa": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
