{
  "name": "janja-express",
  "version": "0.1.2",
  "description": "Janja view engine for Express",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvenv/janja.git",
    "directory": "packages/janja-express"
  },
  "homepage": "https://janja.wenfu.dev",
  "bugs": "https://github.com/vvenv/janja/issues",
  "keywords": [
    "express",
    "view-engine",
    "janja",
    "template"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "janja": "workspace:^"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "express": "^5.3.0",
    "janja": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
