{
  "name": "janja.js",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.0.9",
  "description": "A simple, fast, lightweight, and extensible template engine for Node.js and browsers.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter janja dev",
